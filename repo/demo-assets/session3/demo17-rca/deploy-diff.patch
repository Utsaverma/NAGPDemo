# Deploy diff for release 2.8.1 (Session 3, Demo 17)
# The root cause is in here: the DB connection timeout and pool size
# were both cut in the same release that shipped a new feature,
# and nobody connected the two.

--- a/backend/app/config.py (release 2.8.0)
+++ b/backend/app/config.py (release 2.8.1)
@@ -1,4 +1,4 @@
-DATABASE_COMMAND_TIMEOUT_SECONDS = 30
-DATABASE_MAX_POOL_SIZE = 100
+DATABASE_COMMAND_TIMEOUT_SECONDS = 5
+DATABASE_MAX_POOL_SIZE = 20

--- a/backend/app/routers/invoices.py (release 2.8.0)
+++ b/backend/app/routers/invoices.py (release 2.8.1)
@@ -10,6 +10,16 @@
    @router.get("", response_model=list[Invoice])
    def get_all() -> list[Invoice]:
        return repository.get_all()

+    # New in 2.8.1: per-customer invoice history for the finance
+    # dashboard. Opens its own DB connection per call and does not
+    # reuse the shared pool efficiently under load.
+    @router.get("/history/{customer_name}", response_model=list[Invoice])
+    def get_history(customer_name: str) -> list[Invoice]:
+        return [invoice for invoice in repository.get_all() if invoice.customer_name == customer_name]
+
